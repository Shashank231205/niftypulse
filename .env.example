# Copy to .env and fill in. Every value without a comment marked "optional" is required;
# services refuse to start when one is missing.

APP_ENV=dev
APP_LOG_LEVEL=INFO

# Message bus (each service runs with its own NATS user, see ops/nats.conf)
NATS_URL=nats://127.0.0.1:4222
NATS_USER=
NATS_PASSWORD=
# optional: CA bundle for TLS
NATS_TLS_CA_FILE=

# PostgreSQL (application role, not the superuser)
DB_DSN=postgresql+asyncpg://niftypulse_app:<password>@127.0.0.1:5432/niftypulse

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_METRICS_PORT=

# Upstox market data (recorder only). The access token expires daily.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_ACCESS_TOKEN=
# JSON list of Upstox instrument keys
UPSTOX_INSTRUMENTS=[]

# Tick lake (archiver)
LAKE_ROOT=

# API gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=
GATEWAY_JWT_SECRET=
