# Copy to .env and fill in. Every value without a comment marked "optional" is required;
# services refuse to start when one is missing.

APP_ENV=dev
APP_LOG_LEVEL=INFO

# Message bus (each service runs with its own NATS user, see ops/nats.conf)
NATS_URL=nats://127.0.0.1:4222
NATS_USER=
NATS_PASSWORD=
# optional: CA bundle for TLS
NATS_TLS_CA_FILE=

# PostgreSQL (application role, not the superuser)
DB_DSN=postgresql+asyncpg://niftypulse_app:<password>@127.0.0.1:5432/niftypulse

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_METRICS_PORT=

# Upstox app (login + recorder). The daily access token is written to UPSTOX_TOKEN_FILE
# by `niftypulse login`; keep that path outside the repository.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_API_BASE_URL=https://api.upstox.com
UPSTOX_INSTRUMENT_MASTER_URL=https://assets.upstox.com/market-quote/instruments/exchange/NSE.json.gz
UPSTOX_TOKEN_FILE=

# Subscription universe, resolved to live contracts every morning
UNIVERSE_FUTURES=["NIFTY","BANKNIFTY"]
UNIVERSE_EQUITIES=["HDFCBANK","ICICIBANK","RELIANCE","INFY","BHARTIARTL","TCS","LT","ITC","SBIN","AXISBANK"]
UNIVERSE_INDICES=["NIFTY","BANKNIFTY","INDIA VIX"]
UNIVERSE_OPTION_UNDERLYING=NIFTY
UNIVERSE_OPTION_INDEX_KEY=NSE_INDEX|Nifty 50

# Tick lake (archiver)
LAKE_ROOT=

# API gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=
GATEWAY_JWT_SECRET=
