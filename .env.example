# Copy to .env and fill in. Every key here is required unless marked optional; services
# refuse to start when one is missing. Never commit .env.

# --- application -----------------------------------------------------------
APP_ENV=dev
APP_LOG_LEVEL=INFO

# --- local stack (ops/devstack.ps1) ----------------------------------------
STACK_DATA_DIR=
UV_BIN=
NATS_SERVER_BIN=
POSTGRES_BIN_DIR=
JAEGER_BIN=
PROMETHEUS_BIN=

# --- NATS ------------------------------------------------------------------
NATS_URL=nats://127.0.0.1:4222
NATS_LISTEN=127.0.0.1:4222
NATS_HTTP_LISTEN=127.0.0.1:8222
NATS_SERVER_NAME=niftypulse
NATS_MAX_FILE_STORE=40GB
# optional: CA bundle when NATS runs with TLS
NATS_TLS_CA_FILE=
# one password per service; the stack script maps them to NATS_USER/NATS_PASSWORD
NATS_ADMIN_PASSWORD=
NATS_RECORDER_PASSWORD=
NATS_ARCHIVER_PASSWORD=
NATS_FEATURIZER_PASSWORD=
NATS_PREDICTOR_PASSWORD=
NATS_STRATEGY_PASSWORD=
NATS_MONITOR_PASSWORD=
NATS_GATEWAY_PASSWORD=
# credentials for one-off operator commands (bootstrap)
NATS_USER=admin
NATS_PASSWORD=

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=niftypulse
DB_OWNER_USER=niftypulse_owner
DB_OWNER_PASSWORD=
DB_APP_USER=niftypulse_app
DB_APP_PASSWORD=

# --- telemetry -------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
JAEGER_OTLP_GRPC_LISTEN=127.0.0.1:4317
JAEGER_OTLP_HTTP_LISTEN=127.0.0.1:4318
JAEGER_QUERY_LISTEN=127.0.0.1:16686
JAEGER_QUERY_GRPC_LISTEN=127.0.0.1:16685
JAEGER_HEALTH_LISTEN=127.0.0.1:13133
JAEGER_MAX_TRACES=100000
PROMETHEUS_LISTEN=127.0.0.1:9090
PROMETHEUS_SCRAPE_INTERVAL=5s
PROMETHEUS_EVAL_INTERVAL=15s
METRICS_HOST=127.0.0.1
RECORDER_METRICS_PORT=9101
ARCHIVER_METRICS_PORT=9102
FEATURIZER_METRICS_PORT=9103
PREDICTOR_METRICS_PORT=9104
STRATEGY_METRICS_PORT=9105
MONITOR_METRICS_PORT=9106
GATEWAY_METRICS_PORT=9107
# metrics port for one-off operator commands
OTEL_METRICS_PORT=9100

# --- market data -----------------------------------------------------------
FEED_VENUES=["BINANCE_SPOT","BINANCE_USDM"]
BINANCE_SPOT_WS_URL=wss://stream.binance.com:9443
BINANCE_SPOT_REST_URL=https://api.binance.com
BINANCE_USDM_WS_URL=wss://fstream.binance.com
BINANCE_USDM_REST_URL=https://fapi.binance.com
BINANCE_SPOT_SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT"]
BINANCE_USDM_SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT"]
FEATURES_LEADER_INSTRUMENT=BINANCE_USDM|BTCUSDT
RESEARCH_ARTIFACTS_ROOT=
LAKE_ROOT=

# --- Upstox (NSE) ----------------------------------------------------------
# The daily token is written to UPSTOX_TOKEN_FILE by `niftypulse login`; keep it outside the repo.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_API_BASE_URL=https://api.upstox.com
UPSTOX_INSTRUMENT_MASTER_URL=https://assets.upstox.com/market-quote/instruments/exchange/NSE.json.gz
UPSTOX_TOKEN_FILE=
NSE_UNIVERSE_FUTURES=["NIFTY","BANKNIFTY"]
NSE_UNIVERSE_EQUITIES=["HDFCBANK","ICICIBANK","RELIANCE","INFY","BHARTIARTL","TCS","LT","ITC","SBIN","AXISBANK"]
NSE_UNIVERSE_INDICES=["NIFTY","BANKNIFTY","INDIA VIX"]
NSE_UNIVERSE_OPTION_UNDERLYING=NIFTY
NSE_UNIVERSE_OPTION_INDEX_KEY=NSE_INDEX|Nifty 50

# --- API gateway -----------------------------------------------------------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_JWT_SECRET=
